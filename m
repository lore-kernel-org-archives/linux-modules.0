> +		continue;
> +	want_more:
> +		if(have_more) {
> +			/*
> +			 * We know that no more data (of the same
> type)
> +			 * is coming. Copy the rest verbatim.
> +			 */
> +			*buf++ =3D ch;
> +			continue;
> +		}
> +		chunk_size =3D (p - (const char *)chunk_buf);
> +		/* Processing stalled: need more data */
> +		break;
> +	}
