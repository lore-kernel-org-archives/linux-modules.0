> +				dec_value_start =3D 0;
> +				lp =3D lstart - 1;
> +				continue;
> +			} else {
> +				ASN_DEBUG("state %d at %ld", state,
> (long)(lp - lstart));
> +				break;
> +			}
> +		/* [A-Fa-f] */
> +		case 0x41:case 0x42:case 0x43:case 0x44:case
> 0x45:case 0x46:
> +		case 0x61:case 0x62:case 0x63:case 0x64:case
> 0x65:case 0x66:
