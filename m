> +				*buf++ =3D 0x80 | ((val & 0x3f));
> +			} else if(val < 0x10000) {
> +				*buf++ =3D 0xe0 | ((val >> 12));
> +				*buf++ =3D 0x80 | ((val >> 6) & 0x3f);
> +				*buf++ =3D 0x80 | ((val & 0x3f));
> +			} else if(val < 0x200000) {
> +				*buf++ =3D 0xf0 | ((val >> 18));
> +				*buf++ =3D 0x80 | ((val >> 12) & 0x3f);
> +				*buf++ =3D 0x80 | ((val >> 6) & 0x3f);
> +				*buf++ =3D 0x80 | ((val & 0x3f));
> +			} else if(val < 0x4000000) {
> +				*buf++ =3D 0xf8 | ((val >> 24));
> +				*buf++ =3D 0x80 | ((val >> 18) & 0x3f);
> +				*buf++ =3D 0x80 | ((val >> 12) & 0x3f);
> +				*buf++ =3D 0x80 | ((val >> 6) & 0x3f);
> +				*buf++ =3D 0x80 | ((val & 0x3f));
> +			} else {
> +				*buf++ =3D 0xfc | ((val >> 30) & 0x1);
> +				*buf++ =3D 0x80 | ((val >> 24) & 0x3f);
> +				*buf++ =3D 0x80 | ((val >> 18) & 0x3f);
> +				*buf++ =3D 0x80 | ((val >> 12) & 0x3f);
> +				*buf++ =3D 0x80 | ((val >> 6) & 0x3f);
> +				*buf++ =3D 0x80 | ((val & 0x3f));
> +			}
> +		} else {
> +			/*
> +			 * Ugly, limited parsing of &amp; &gt; &lt;
> +			 */
> +			char *sc =3D (char *)memchr(p, 0x3b, len > 5 ?
> 5 : len);
> +			if(!sc) goto want_more;
> +			if((sc - p) =3D=3D 4
> +				&& p[1] =3D=3D 0x61	/* 'a' */
> +				&& p[2] =3D=3D 0x6d	/* 'm' */
> +				&& p[3] =3D=3D 0x70	/* 'p' */) {
> +				*buf++ =3D 0x26;
> +				p =3D sc;
> +				continue;
> +			}
> +			if((sc - p) =3D=3D 3) {
> +				if(p[1] =3D=3D 0x6c) {
> +					*buf =3D 0x3c;	/* '<' */
> +				} else if(p[1] =3D=3D 0x67) {
> +					*buf =3D 0x3e;	/* '>' */
> +				} else {
